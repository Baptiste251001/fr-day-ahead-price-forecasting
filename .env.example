# Copy this file to .env and fill in your own credentials.
# Never commit the real .env file.

# ENTSO-E Transparency Platform API token.
# Request one by creating a free account at https://transparency.entsoe.eu/
# and emailing transparency@entsoe.eu to ask for API access (see their FAQ).
ENTSOE_API_TOKEN=

# Optional: RTE Data Portal (eCO2mix, France-specific enrichment).
# Register an application at https://data.rte-france.com/
RTE_CLIENT_ID=
RTE_CLIENT_SECRET=

# Optional: free weather data provider for population-weighted HDD/CDD
# (e.g. Open-Meteo requires no key; placeholder kept for providers that do).
WEATHER_API_KEY=

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/

# --- Virtual environments ---
.venv/
venv/
env/
.uv/

# --- Environment / secrets ---
.env
.env.*
!.env.example

# --- Data (never commit market data or caches) ---
data/raw/**
data/interim/**
data/processed/**
!data/raw/.gitkeep
!data/interim/.gitkeep
!data/processed/.gitkeep

# --- Reference materials (copyrighted papers, not for public redistribution) ---
reference/*.pdf

# --- Notebooks: keep source, drop heavy/output-laden checkpoints ---
.ipynb_checkpoints/

# --- Reports (generated artifacts, regenerate via pipeline) ---
reports/figures/*
!reports/figures/.gitkeep
reports/*.csv

# --- Testing / linting / typing caches ---
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# --- OS / editor ---
.DS_Store
Thumbs.db
.vscode/
.idea/

# --- Logs ---
*.log
